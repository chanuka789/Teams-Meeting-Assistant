{
  "name": "apc-interview-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "APC interview assistant: listens to RICS APC assessors on Teams, detects questions and shows answers from your competency library and case study. Uses OpenRouter.",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "express": "^5.3.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "lucide-static": "^1.65.0"
  }
}
