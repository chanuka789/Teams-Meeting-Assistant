# Required: your OpenRouter key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Strongly recommended: password to open the app (anyone with the URL could use your credits otherwise)
APP_PASSWORD=
# Optional overrides
STT_MODEL=openai/whisper-large-v3-turbo
ANSWER_MODEL=anthropic/claude-haiku-5.5
STT_LANGUAGE=en
PORT=3000
