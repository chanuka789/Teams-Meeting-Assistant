# Required
OPENROUTER_API_KEY=
DATABASE_URL=postgres://postgres@localhost:5432/tma
# Setup key for creating the first admin account
APP_PASSWORD=
# Railway bucket (leave empty locally to store files in ./data/uploads)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional defaults (users can change models in Settings)
ANSWER_MODEL=anthropic/claude-sonnet-5.5
ANSWER_REASONING=low
DETECT_MODEL=anthropic/claude-haiku-5.5
STT_MODEL=openai/whisper-large-v3-turbo
STT_LANGUAGE=en
PORT=3000
